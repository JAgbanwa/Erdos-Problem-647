\[
f(n-1)=(n-1)+\tau(n-1)\le n+2 \quad\Rightarrow\quad \tau(n-1)\le 3,
\tag{1}
\]
and
\[
f(n-2)=(n-2)+\tau(n-2)\le n+2 \quad\Rightarrow\quad \tau(n-2)\le 4.
\tag{2}
